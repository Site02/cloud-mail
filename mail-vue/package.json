{
  "name": "mail-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node tools/generate-localized-manifests.mjs && vite --mode dev",
    "remote": "node tools/generate-localized-manifests.mjs && vite --mode remote",
    "build": "node tools/generate-localized-manifests.mjs && vite build --mode release",
    "eo": "node tools/generate-localized-manifests.mjs && vite build --mode eo",
    "check:manifests": "node tools/generate-localized-manifests.mjs --check",
    "check:locale": "node tools/check-locale-candidate.mjs",
    "check:mail-flows": "node tools/verify-mail-flows.cjs",
    "preview": "vite preview",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@iconify/vue": "^4.3.0",
    "@vueuse/components": "^14.1.0",
    "@vueuse/core": "^12.0.0",
    "axios": "1.15.2",
    "compressorjs": "^1.2.1",
    "date-time-format-timezone": "^1.0.22",
    "dayjs": "^1.11.13",
    "dexie": "^4.0.11",
    "echarts": "^5.6.0",
    "element-plus": "^2.13.1",
    "lodash-es": "^4.17.21",
    "nprogress": "^0.2.0",
    "path": "^0.12.7",
    "pinia": "^3.0.2",
    "pinia-plugin-persistedstate": "^4.2.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.10",
    "vue-router": "^4.5.0",
    "workbox-window": "7.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "fake-indexeddb": "^6.2.5",
    "less": "^4.2.2",
    "playwright": "1.61.0",
    "sass": "^1.82.0",
    "terser": "^5.39.0",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.7.0",
    "vite": "7.1.5",
    "vite-plugin-pwa": "^1.0.3"
  }
}
